.intel-toolbar {
  align-items: flex-start;
  gap: 16rpx;
}

.intel-tabs {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding-bottom: 6rpx;
  margin-bottom: 24rpx;
}

.intel-tab {
  min-width: 150rpx;
  flex: none;
  font-size: 20rpx;
}

.intel-card {
  margin-bottom: 16rpx;
}

.intel-card-top,
.intel-card-footer {
  align-items: flex-start;
}

.intel-meta {
  color: var(--40k-iron);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.intel-title {
  margin-top: 12rpx;
  color: var(--40k-parchment);
  font-family: "Cinzel", serif;
  font-size: 30rpx;
  line-height: 1.3;
}

.intel-description {
  margin-top: 14rpx;
  color: var(--40k-parchment);
  font-size: 24rpx;
  line-height: 1.6;
}

.intel-read {
  color: var(--40k-gold);
  font-size: 20rpx;
  text-transform: uppercase;
}

.intel-message {
  color: var(--40k-parchment);
  font-size: 24rpx;
  line-height: 1.5;
}

.intel-message-danger {
  border-color: rgba(179, 100, 112, 0.2);
  background:
    linear-gradient(90deg, var(--app-danger-wash), transparent 36%),
    var(--app-card-alt-bg);
}

.reader-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(5, 6, 7, 0.78);
}

.reader-panel {
  width: 100%;
  max-height: 88vh;
  margin-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.reader-header {
  align-items: flex-start;
  gap: 18rpx;
}

.reader-close {
  min-width: 132rpx;
}

.reader-title {
  margin-top: 10rpx;
  color: var(--40k-parchment);
  font-family: "Cinzel", serif;
  font-size: 32rpx;
  line-height: 1.35;
}

.reader-scroll {
  max-height: 50vh;
  margin: 20rpx 0;
  padding-right: 8rpx;
}

.reader-loading,
.reader-content {
  color: var(--40k-parchment);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.reader-footer {
  gap: 14rpx;
  align-items: center;
}
