.clock-face {
  text-align: center;
  padding: 64rpx 28rpx;
}

.clock-time {
  color: var(--40k-parchment);
  font-family: "Cinzel", serif;
  font-size: 96rpx;
  letter-spacing: 8rpx;
  line-height: 1;
  margin-top: 18rpx;
}

.clock-phase {
  margin-top: 18rpx;
  color: var(--40k-gold);
  font-family: "Cinzel", serif;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.clock-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.clock-actions .button {
  min-width: 0;
}

.clock-detail-card {
  min-height: 180rpx;
}
